# ─────────────────────────────────────────────────────────────────────
# Deployment secrets template — copie este arquivo para .env.local
# e preencha com os valores reais. NUNCA commite o .env.local.
# ─────────────────────────────────────────────────────────────────────

# GitHub Personal Access Token (escopo: repo)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub username/org dono do repositório
GITHUB_OWNER=

# Nome do repositório no GitHub (sem o owner)
GITHUB_REPO=

# Vercel API Token
# https://vercel.com/account/tokens
VERCEL_TOKEN=

# (opcional) Slug do time/scope no Vercel — deixe vazio se for conta pessoal
VERCEL_SCOPE=

# (opcional) Nome do projeto no Vercel — se vazio, será criado a partir do repo
VERCEL_PROJECT=
